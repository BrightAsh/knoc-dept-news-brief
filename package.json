{
  "name": "knoc-dept-news-brief",
  "version": "0.1.0",
  "private": true,
  "description": "Date-based news collector for KNOC department briefings.",
  "type": "module",
  "scripts": {
    "collect": "node scripts/collect.mjs",
    "analyze": "node scripts/analyze.mjs",
    "brief": "node scripts/collect.mjs && node scripts/analyze.mjs",
    "collect:yesterday": "node scripts/collect.mjs --date yesterday",
    "collect:body": "node scripts/collect.mjs --include-body --body-concurrency 6",
    "analyze:llm": "node scripts/analyze.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
