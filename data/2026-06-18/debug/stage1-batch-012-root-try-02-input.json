    {
      "article_id": "36bc4226298bac43",
      "publisher": "경향신문",
      "title": "[기고]선원의 품격과 해양의 미래",
      "url": "https://www.khan.co.kr/article/202606181954005",
      "published_at": "2026-06-18T10:54:00.000Z",
      "stage0_group": "B",
      "stage1_candidate": null,
